# ──────────────────────────────────────────────────────────────────────────
# Norax AI — environment template
# Copy to .env and fill in. Never commit .env.
# Run `bash setup.sh` for an interactive guided setup.
# ──────────────────────────────────────────────────────────────────────────

# ── Owner identity ────────────────────────────────────────────────────────
# How Norax recognizes you across channels.
NORAX_OWNER_ID=
NORAX_OWNER_IDS=
NORAX_OWNER_LABEL=Owner
NORAX_OWNER_TIMEZONE=UTC

# ── Local web chat (Agent OS dashboard) ───────────────────────────────────
# The dashboard runs on http://127.0.0.1:8822 and proxies to the runtime
# on :4101. Set a chat token to authenticate the bridge — any random string
# works. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
NORAX_AGENT_OS_CHAT_TOKEN=
NORAX_RUNTIME_CHAT_TOKEN=
# Optional: auth token for the dashboard itself (empty = no auth, local only)
NORAX_OS_TOKEN=

# ── Ports (important if you run other local services) ──────────
# Ports are explicit. Startup fails clearly if a configured port is occupied;
# the runtime never moves silently while clients keep targeting the old port.
# Runtime HTTP server (default 4101)
NORAX_HTTP_BIND=127.0.0.1
NORAX_HTTP_PORT=4101
# Agent OS web dashboard (default 8822)
NORAX_OS_BIND=127.0.0.1
NORAX_OS_PORT=8822

# ── Discord (optional) ────────────────────────────────────────────────────
# Disabled by default. The local dashboard works without Discord.
NORAX_DISCORD_TOKEN=
NORAX_DISCORD_ENABLED=false
NORAX_DISCORD_CONFIG_JSON={"allowBots":false,"dmPolicy":"deny","groupPolicy":"deny","allowFrom":[],"guilds":{}}

# ── Model providers ───────────────────────────────────────────────────────
# Defaults use local Ollama. Add more providers via the dashboard Settings
# tab or the /api/providers API after startup.
NORAX_DEFAULT_MODEL=llama3.2:3b
NORAX_DEFAULT_PROVIDER=ollama
# Ollama endpoint (default: http://127.0.0.1:11434)
NORAX_OLLAMA_URL=http://127.0.0.1:11434
# OpenRouter token (optional — for OpenRouter aggregator access)
NORAX_OPENROUTER_TOKEN=

# ── Gateway / remote relay (optional) ─────────────────────────────────────
NORAX_GATEWAY_TOKEN=
NORAX_REMOTE_RELAY_URL=http://127.0.0.1:8765/remote
# Required by relay control endpoints. Generate a long random value.
NORAX_REMOTE_CONTROL_TOKEN=
# Public WebSocket base returned by enrollment, e.g. https://agent.example.
NORAX_REMOTE_PUBLIC_URL=
# High-risk onboarding mode; authenticated enrollment is the secure default.
NORAX_REMOTE_ALLOW_PUBLIC_ENROLL=false
NORAX_HTTP_KEYS=

# ── Observability (optional) ──────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Durable state (optional) ──────────────────────────────────────────────
# Defaults follow XDG state/data locations. Commerce sessions and their signing
# key live under NORAX_STATE_DIR/commerce, never inside the source checkout.
NORAX_STATE_DIR=
NORAX_MEMORY_ROOT=
NORAX_COMMERCE_STATE_DIR=
NORAX_AGENT_OS_STATE_DIR=

# ── Safety limits ─────────────────────────────────────────────────────────
# Non-owner filesystem tools are confined to NORAX_WORKSPACE plus the optional
# path-separator-delimited extra roots below. Sensitive paths remain owner-only.
NORAX_WORKSPACE=
NORAX_NON_OWNER_ALLOWED_ROOTS=
NORAX_NON_OWNER_ALLOW_SENSITIVE_PATHS=false
# MCP blocks approval-sensitive runtime/system mutations by default because a
# separate MCP process cannot consume Discord approvals. Set this only when the
# MCP host itself authenticates a human before every destructive tool call.
NORAX_MCP_TRUST_HOST_APPROVALS=false
# Round/time limits remain active with their documented defaults.
NORAX_MAX_TOOL_ROUNDS=250
NORAX_THINKING_EFFORT=medium
NORAX_FLOW_TIMEOUT_SECONDS=14400
NORAX_AGENT_HARD_ROUND_CAP=250
NORAX_AGENT_MAX_TOOL_CALLS=1000
# Optional process-wide LLM call breaker. Keep 0 for unrestricted local and
# long-running work; set positive limits when an operator wants a spend ceiling.
NORAX_LLM_MAX_CALLS_PER_MIN=0
NORAX_LLM_MAX_CALLS_PER_HOUR=0

# Background autonomy is opt-in. Enabling a specific experiment also requires
# the master switch so a stray feature flag cannot start unsolicited work.
NORAX_AUTONOMY_ENABLED=false
NORAX_AUTONOMY_PROMPT_OPT=false
NORAX_AUTONOMY_MULTI_AGENT=false
# Autonomous learning performs web searches and may execute staged audit
# scripts. Prefer an isolated staging host.
NORAX_AUTONOMY_LEARNING=false
# Heuristic episodic replay/skill generation and harness report mining are
# separate opt-ins from the production memory consolidator.
NORAX_IDLE_LEARNING_ENABLED=false
NORAX_HARNESS_ANALYSIS_ENABLED=false
NORAX_EXPERIMENTAL_COGNITIVE_SIGNALS=false
# Private fleet maintenance is never run by a generic install. Set only on a
# host that intentionally owns the legacy fleet-healthcheck user services.
NORAX_APPLY_FLEET_STARTUP_FIXES=false
NORAX_STAGING_HOST=
NORAX_STAGING_PATH=~/norax
# Local execution is a separate explicit opt-in and is not OS-sandboxed.
NORAX_LEARNING_ALLOW_LOCAL_TESTS=false

# ── Standalone desktop helpers (optional) ────────────────────────────────
# Prefer the session-provided DISPLAY. Set this only when a service cannot
# inherit it. Helpers do not choose between multiple desktops implicitly.
NORAX_DISPLAY=
# Interactive desktop-portal screenshot prompts and fallback to an Xvfb :99
# session are both opt-in so background perception cannot target another
# desktop or display a surprise permission dialog.
NORAX_DMAP_PORTAL_CAPTURE=false
NORAX_DMAP_XVFB_FALLBACK=false
# Bound expensive per-control OCR and reject coordinate refs from old maps.
NORAX_DMAP_MAX_BUTTON_OCR=32
NORAX_DMAP_MAX_ACTION_AGE_SECONDS=60
# Optional path-separator-delimited roots for the standalone motor helper.
# NORAX_WORKSPACE and /tmp are already allowed.
NORAX_MOTOR_ALLOWED_ROOTS=
# Gate telemetry is disabled by default to keep the action hot path free of
# file I/O. Enable only when local aggregate counters are wanted.
NORAX_ACTION_GATE_TELEMETRY=false
# Optional override for the standalone vision inference helper. The configured
# model is probed when used; listing it here does not imply it is installed.
OLLAMA_VISION_URL=http://127.0.0.1:11434
NORAX_VISION_MODEL=qwen2.5vl:7b
# Optional private directory for flow-guard coordination files.
NORAX_FLOW_STATE_DIR=

# ── SMTP email alerts (optional) ──────────────────────────────────────────
# Used by the Agent OS dashboard backup alert channel.
NORAX_SMTP_USER=
NORAX_SMTP_PASS=
